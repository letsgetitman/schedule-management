DATABASE_URL="file:./dev.db"

# next-auth v5 session signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Naver Cloud Platform > AI·NAVER API > Maps (Web Dynamic Map) client ID.
# Safe to expose to the browser; the map script needs it client-side.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID="antovjmqgf"

# Naver Developers (openapi.naver.com) > 검색 (지역) API credentials.
# Server-only — never prefix these with NEXT_PUBLIC_.
NAVER_SEARCH_CLIENT_ID=""
NAVER_SEARCH_CLIENT_SECRET=""
